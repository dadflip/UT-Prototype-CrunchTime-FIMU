# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Excel Configuration (Optional)
EXCEL_SYNC_ENABLED=true
EXCEL_SYNC_INTERVAL_MS=5000

# Application Settings
NEXT_PUBLIC_APP_NAME=Fimu Voting
NEXT_PUBLIC_APP_VERSION=1.0.0

# Session Configuration
SESSION_TOKEN_EXPIRY_HOURS=24

# Admin Email for Initial Setup
ADMIN_EMAIL_FOR_SIGNUP=admin@fimu.local
